APP_ENV=development
DATABASE_URL=sqlite:///./middleman.db

# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a temporary key is generated at startup (token mappings lost on restart).
ENCRYPTION_KEY=

# Free providers — get keys at:
#   Groq:   https://console.groq.com
#   Gemini: https://aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=

# Paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use when none is specified in the request
DEFAULT_LLM_PROVIDER=groq

# Default models per provider (can be overridden per request in the UI)
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
TOKEN_TTL_MINUTES=30
PII_CONFIDENCE_THRESHOLD=0.65
MAX_PROMPT_LENGTH=32000
ENABLE_REHYDRATION=true
BLOCK_HIGH_RISK_PROMPTS=true
LLM_TIMEOUT_SECONDS=30
