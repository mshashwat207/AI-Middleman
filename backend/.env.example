APP_ENV=development
DATABASE_URL=sqlite:///./middleman.db
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=mock
DEFAULT_MODEL=gpt-3.5-turbo
TOKEN_TTL_MINUTES=30
PII_CONFIDENCE_THRESHOLD=0.70
